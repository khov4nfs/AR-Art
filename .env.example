# EVERIE — copy to .env.local (dev) or set in your host's environment (prod).

# HMAC key for the admin session cookie. REQUIRED in production; use a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset, a random key is generated once and stored in data/.session-secret.
SESSION_SECRET=

# Password for the seed super admin (admin@everie.vn). Applied when the store is first
# created, and once to an existing store whose admin still has the published default
# password "admin123" (hashed on next server start). Change it later in Admin → Users.
ADMIN_INITIAL_PASSWORD=
# Optional: seed content editor (editor@everie.vn), default "editor123".
EDITOR_INITIAL_PASSWORD=

# Cookie "Secure" flag: defaults to true when NODE_ENV=production. Set to false only when
# serving production over plain HTTP on a LAN (not recommended).
# COOKIE_SECURE=false

# Optional self-hosted Hunyuan3D endpoint for the admin "Tạo 3D từ ảnh" button.
# HUNYUAN3D_API_URL=
# HUNYUAN3D_API_KEY=

# Public site URL used in emailed links (verify email, reset password).
# If unset, the request's Host header is used.
SITE_URL=https://everievn.com

# Optional SMTP for customer emails (verify email + forgot password links).
# When SMTP_HOST and SMTP_FROM are unset, "Quên mật khẩu" tells customers to contact
# the shop, and staff set a temporary password in Admin → Users.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true for port 465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="EVERIE <no-reply@everievn.com>"

# AR uses EVERIE local filesystem storage, not Supabase.
# Private registry: data/ar-artworks.json (never public/)
# Public media: public/uploads/ar/
# Login: existing EVERIE everie_session cookie and SESSION_SECRET.
# AR_ART_FFMPEG_PATH=/usr/bin/ffmpeg
# AR_ART_FFPROBE_PATH=/usr/bin/ffprobe

# Docker deployment: production defaults preserve the existing EVERIE VPS.
# For complete handoff use deploy/.env.production.example.
# EVERIE_DATA_DIR=/opt/everievn/data
# EVERIE_UPLOAD_DIR=/opt/everievn/public/uploads
# EVERIE_DOCKER_NETWORK=vms_edge
