# Copy to deploy/.env on the VPS and chmod 600. Never commit it.
# Do not copy demo secrets or demo customer data into production.
# Required: preserve the original EVERIE SESSION_SECRET unchanged.
SESSION_SECRET=
SITE_URL=https://everievn.com

# Current EVERIE deployment defaults (no source edits needed).
EVERIE_COMPOSE_PROJECT=everievn
EVERIE_CONTAINER_NAME=everievn-web
EVERIE_IMAGE=everievn-web:latest
EVERIE_DATA_DIR=/opt/everievn/data
EVERIE_UPLOAD_DIR=/opt/everievn/public/uploads
EVERIE_DOCKER_NETWORK=vms_edge

# Optional self-hosted image-to-3D and mail.
# HUNYUAN3D_API_URL=
# HUNYUAN3D_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# ADMIN_INITIAL_PASSWORD=
# EDITOR_INITIAL_PASSWORD=
